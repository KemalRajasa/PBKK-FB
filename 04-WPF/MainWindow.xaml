<Window x:Class="LibraryManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Management"
        Height="680"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= FORM ================= -->
        <StackPanel Grid.Column="0">
            <TextBlock x:Name="lblFormTitle"
                       Text="INPUT BUKU"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Text="ISBN"/>
            <TextBox x:Name="txtIsbn" Height="30" Margin="0,3,0,10"/>

            <TextBlock Text="Judul Buku"/>
            <TextBox x:Name="txtJudul" Height="30" Margin="0,3,0,10"/>

            <TextBlock Text="Penulis"/>
            <TextBox x:Name="txtPenulis" Height="30" Margin="0,3,0,10"/>

            <TextBlock Text="Kategori"/>
            <ComboBox x:Name="cmbKategori" Height="30" Margin="0,3,0,10">
                <ComboBoxItem Content="Teknologi"/>
                <ComboBoxItem Content="Novel"/>
                <ComboBoxItem Content="Sains"/>
                <ComboBoxItem Content="Sejarah"/>
                <ComboBoxItem Content="Bisnis"/>
            </ComboBox>

            <TextBlock Text="Kondisi Buku"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <RadioButton x:Name="rbBaru" Content="Baru" Margin="0,0,20,0"/>
                <RadioButton x:Name="rbBekas" Content="Bekas"/>
            </StackPanel>

            <TextBlock Text="Tanggal Terbit"/>
            <DatePicker x:Name="dpTerbit" Height="30" Margin="0,3,0,10"/>

            <CheckBox x:Name="chkDipinjam"
                      Content="Sedang dipinjam"
                      Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnSimpan"
                        Content="Simpan"
                        Width="95" Height="38"
                        Margin="0,0,10,0"
                        Click="BtnSimpan_Click"/>
                <Button Content="Reset"
                        Width="95" Height="38"
                        Click="BtnReset_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ================= DATA ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="DATA BUKU"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Cari (judul / penulis / ISBN)"/>
                <TextBox x:Name="txtCari"
                         Height="30"
                         Margin="0,3,0,0"
                         TextChanged="TxtCari_TextChanged"/>
            </StackPanel>

            <DataGrid Grid.Row="2"
                      x:Name="dgBuku"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      SelectionChanged="DgBuku_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="100"/>
                    <DataGridTextColumn Header="Judul" Binding="{Binding Judul}" Width="*"/>
                    <DataGridTextColumn Header="Penulis" Binding="{Binding Penulis}" Width="110"/>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="80"/>
                    <DataGridTextColumn Header="Kondisi" Binding="{Binding Kondisi}" Width="60"/>
                    <DataGridTextColumn Header="Terbit"
                                        Binding="{Binding TanggalTerbit, StringFormat=dd/MM/yyyy}"
                                        Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="lblJumlah"
                           Text="Jumlah Buku: 0"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Edit"
                            Width="95" Height="35"
                            Margin="0,0,10,0"
                            Click="BtnEdit_Click"/>
                    <Button Content="Hapus"
                            Width="95" Height="35"
                            Click="BtnHapus_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
